{
  "name": "火莲风险",
  "icon": "friday_cultivation:spell_book_buddha_fire_lotus",
  "category": "friday_cultivation:forbidden_arts",
  "sortnum": 3,
  "pages": [
    {
      "type": "patchouli:text",
      "text": "佛怒火莲破坏范围大、特效重、持续伤害强。它适合清场或打大型敌人，不适合在自家基地内随便试法。"
    },
    {
      "type": "patchouli:text",
      "text": "若火莲撞上护宗大阵，会在护罩位置爆炸并由护罩吸收，不破坏阵法内部。这让宗门护罩可以承受大型仙术测试。"
    }
  ]
}
